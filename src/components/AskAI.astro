---
// Ask AI — client-side research assistant over the California Codes corpus.
// Provider switchable: Sarvam AI, OpenRouter, or Mistral. Keys stay in localStorage.
---
<div id="askai">
  <div class="askai__settings">
    <label>
      Provider
      <select id="askai-provider">
        <option value="openrouter">OpenRouter</option>
        <option value="sarvam">Sarvam AI</option>
        <option value="mistral">Mistral AI</option>
      </select>
    </label>
    <label>
      Model
      <input id="askai-model" type="text" placeholder="model id" />
    </label>
    <label>
      API key <span class="askai__hint">(stored only in your browser)</span>
      <input id="askai-key" type="password" placeholder="paste your key" autocomplete="off" />
    </label>
  </div>
  <div id="askai-log" class="askai__log"></div>
  <form id="askai-form" class="askai__form">
    <input id="askai-q" type="text" placeholder="e.g. What are the residency requirements for filing for divorce in California?" autocomplete="off" />
    <button type="submit">Ask</button>
  </form>
  <p class="askai__hint">
    Questions are answered by the selected model using the most relevant sections retrieved from this site.
    AI answers may contain mistakes — verify against the official source. Not legal advice.
  </p>
</div>

<style>
  #askai { max-width: 48rem; }
  .askai__settings { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem; }
  .askai__settings label { display: flex; flex-direction: column; font-size: 0.8rem; gap: 0.25rem; flex: 1 1 10rem; }
  .askai__settings select, .askai__settings input {
    font: inherit; padding: 0.4rem 0.5rem; border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem; background: var(--sl-color-white); color: inherit;
  }
  :root[data-theme='dark'] .askai__settings select,
  :root[data-theme='dark'] .askai__settings input { background: var(--sl-color-black); }
  .askai__log { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem; }
  .askai__msg { padding: 0.6rem 0.8rem; border-radius: 0.5rem; white-space: pre-wrap; }
  .askai__msg--user { background: var(--sl-color-accent-low); }
  .askai__msg--assistant { background: var(--sl-color-gray-7, #f1f1f4); }
  :root[data-theme='dark'] .askai__msg--assistant { background: var(--sl-color-gray-2, #26262b); }
  .askai__msg--assistant a { color: var(--sl-color-text-accent); }
  .askai__sources { font-size: 0.8rem; margin-top: 0.4rem; }
  .askai__form { display: flex; gap: 0.5rem; }
  .askai__form input { flex: 1; font: inherit; padding: 0.5rem 0.65rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; }
  .askai__form button { font: inherit; font-weight: 600; padding: 0.5rem 1rem; border: none; border-radius: 0.4rem; background: var(--sl-color-text-accent); color: var(--sl-color-white); cursor: pointer; }
  .askai__hint { font-size: 0.75rem; color: var(--sl-color-gray-3); }
</style>

<script>
  const PROVIDERS = {
    openrouter: {
      label: 'OpenRouter',
      url: 'https://openrouter.ai/api/v1/chat/completions',
      defaultModel: 'openrouter/auto',
      keyHeader: (k) => ({ Authorization: 'Bearer ' + k }),
      browserFriendly: true,
    },
    sarvam: {
      label: 'Sarvam AI',
      url: 'https://api.sarvam.ai/v1/chat/completions',
      defaultModel: 'sarvam-m',
      keyHeader: (k) => ({ 'api-subscription-key': k }),
      browserFriendly: false,
    },
    mistral: {
      label: 'Mistral AI',
      url: 'https://api.mistral.ai/v1/chat/completions',
      defaultModel: 'mistral-small-latest',
      keyHeader: (k) => ({ Authorization: 'Bearer ' + k }),
      browserFriendly: false,
    },
  };

  const SYSTEM_PROMPT = 'You are the California legislative research assistant for this documentation site. Use the retrieved sections provided as your evidence. For every substantive legal claim, provide a citation (code and section number) when one is available. Never invent statutory text, section numbers, history, effective dates, case holdings, or sources. Treat the corpus as a dated research snapshot and clearly identify uncertainty, missing facts, and temporal limits. Give short answers for narrow lookups; give longer, well-organized answers when the question is broad. Provide public legal information, not legal advice. When the retrieved material is insufficient, say so and direct the user to the official California Legislative Information source (https://leginfo.legislature.ca.gov/).';

  const el = (id) => document.getElementById(id);
  const providerSel = el('askai-provider'), modelIn = el('askai-model'), keyIn = el('askai-key');
  const log = el('askai-log'), form = el('askai-form'), qIn = el('askai-q');

  const lsKey = (p) => 'askai-key-' + p;
  const lsModel = (p) => 'askai-model-' + p;

  function currentProvider() { return PROVIDERS[providerSel.value]; }

  function loadSettings() {
    providerSel.value = localStorage.getItem('askai-provider') || 'openrouter';
    modelIn.value = localStorage.getItem(lsModel(providerSel.value)) || currentProvider().defaultModel;
    keyIn.value = localStorage.getItem(lsKey(providerSel.value)) || '';
  }

  providerSel.addEventListener('change', loadSettings);
  modelIn.addEventListener('change', () => localStorage.setItem(lsModel(providerSel.value), modelIn.value.trim()));

  function addMsg(text, cls, sources) {
    const div = document.createElement('div');
    div.className = 'askai__msg askai__msg--' + cls;
    div.textContent = text;
    if (sources && sources.length) {
      const s = document.createElement('div');
      s.className = 'askai__sources';
      s.appendChild(document.createTextNode('Sources: '));
      sources.forEach((r, i) => {
        if (i) s.appendChild(document.createTextNode(' - '));
        const a = document.createElement('a');
        a.href = r.url; a.textContent = r.title || r.url;
        s.appendChild(a);
      });
      div.appendChild(s);
    }
    log.appendChild(div);
    div.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  let pagefind = null;
  async function getPagefind() {
    if (pagefind) return pagefind;
    const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
    pagefind = await import(/* @vite-ignore */ base + '/pagefind/pagefind.js');
    return pagefind;
  }

  async function retrieve(question) {
    try {
      const pf = await getPagefind();
      const res = await pf.search(question, { limit: 6 });
      const out = [];
      for (const r of res.results.slice(0, 6)) {
        const data = await r.data();
        out.push({ title: data.meta?.title || r.excerpt, url: data.url, excerpt: data.excerpt });
      }
      return out;
    } catch (e) {
      return [];
    }
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const question = qIn.value.trim();
    if (!question) return;
    const p = currentProvider();
    const key = keyIn.value.trim();
    const model = modelIn.value.trim() || p.defaultModel;
    if (!key) { addMsg('Please paste an API key for ' + p.label + ' first. Keys are stored only in this browser (localStorage).', 'assistant'); return; }
    localStorage.setItem(lsKey(providerSel.value), key);
    localStorage.setItem('askai-provider', providerSel.value);
    localStorage.setItem(lsModel(providerSel.value), model);

    addMsg(question, 'user');
    qIn.value = '';
    const thinking = document.createElement('div');
    thinking.className = 'askai__msg askai__msg--assistant';
    thinking.textContent = 'Searching the codes and asking ' + p.label + '...';
    log.appendChild(thinking);

    const sources = await retrieve(question);
    const context = sources.length
      ? 'Retrieved sections from the corpus:\n\n' + sources.map((s, i) =>
          '[' + (i + 1) + '] ' + s.title + '\n' + (s.excerpt || '').replace(/<[^>]+>/g, '').slice(0, 1200)).join('\n\n')
      : 'No relevant sections were retrieved.';

    const messages = [
      { role: 'system', content: SYSTEM_PROMPT },
      { role: 'user', content: context + '\n\nQuestion: ' + question },
    ];

    try {
      const resp = await fetch(p.url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...p.keyHeader(key) },
        body: JSON.stringify({ model, messages, max_tokens: 1200 }),
      });
      if (!resp.ok) {
        const body = await resp.text();
        throw new Error('HTTP ' + resp.status + ' - ' + body.slice(0, 300));
      }
      const data = await resp.json();
      const answer = data.choices?.[0]?.message?.content || '(empty response)';
      thinking.remove();
      addMsg(answer, 'assistant', sources.map(s => ({ title: s.title, url: s.url })));
    } catch (err) {
      thinking.remove();
      let msg = 'Request failed: ' + err.message;
      if (!p.browserFriendly && /Failed to fetch|NetworkError|CORS/i.test(String(err))) {
        msg += '\n\nThis provider may not allow direct browser calls (CORS). OpenRouter is the most browser-friendly option.';
      }
      addMsg(msg, 'assistant');
    }
  });

  loadSettings();
</script>
